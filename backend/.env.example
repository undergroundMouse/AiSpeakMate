APP_NAME=AiSpeakMate
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aispeakmate
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=

# Pronunciation — SpeechSuper (iFlytek ecosystem)
SPEECHSUPER_APP_KEY=
SPEECHSUPER_SECRET_KEY=
SPEECHSUPER_API_KEY=
SPEECHSUPER_ENDPOINT=https://api.speechsuper.com

# TTS — iFlytek Online (can reuse the same iFlytek open-platform app as SpeechSuper)
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_TTS_HOST=tts-api.xfyun.cn
IFLYTEK_TTS_PATH=/v2/tts

# ASR — Faster-Whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
