APP_NAME=AiSpeakMate
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aispeakmate
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=

# iFlytek — TTS + pronunciation evaluation (ISE)
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_TTS_HOST=tts-api.xfyun.cn
IFLYTEK_TTS_PATH=/v2/tts
IFLYTEK_ISE_HOST=ise-api.xfyun.cn
IFLYTEK_ISE_PATH=/v2/open-ise

# ASR — Faster-Whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
